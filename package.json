{
	"name": "maplibrex-svelte",
	"version": "0.1.0",
	"description": "Component-oriented Svelte 5 bindings for MapLibre GL JS, written in TypeScript.",
	"license": "MIT",
	"author": "Yendris Rogelio Cruz Mendoza",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CountlinkX-Solutions/maplibrex-svelte.git"
	},
	"bugs": {
		"url": "https://github.com/CountlinkX-Solutions/maplibrex-svelte/issues"
	},
	"homepage": "https://countlinkx-solutions.github.io/maplibrex-svelte/",
	"keywords": [
		"svelte",
		"sveltekit",
		"maplibre",
		"maplibre-gl",
		"map",
		"gis",
		"webgl",
		"typescript"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run check && npm run test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"maplibre-gl": "^6.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^26.1.0",
		"maplibre-gl": "^6.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.24",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	}
}
